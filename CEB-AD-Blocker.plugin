#!name = 光大银行广告屏蔽
#!desc = Loon 纯 JS 过滤：改写光大银行 App 配置响应，清空开屏广告 / 首页弹窗 / 主视图公告下方推广内容，不拦截功能域名
#!author = WorkBuddy
#!homepage = https://github.com/aoconch/cebbank-ad-blocker-loon
#!tag = 去广告, 光大银行
#!type = normal

# ============================================================
# 策略（v2，2026-11-16）
#   不拦截 static.cebbank.com —— 该域承载 App 全部原生配置与图片，
#   粗暴 REJECT 会导致功能卡片缺失。仅通过 [Script] http-response
#   改写布局配置 JSON：
#     · KPPage.json 的 ClientNoticeList（开屏广告）→ 清空广告条目
#     · KPPage.json 的 HomePopList（首页弹窗广告）→ 清空广告条目
#   [Rule] 埋点 / 统计域 datafinder.cebbank.com 用 Loon 原生
#     REJECT-DICT-NO-DROP（strings_Loon.txt:14416-14417 词表）返回 200 `{}`，
#     不再走普通 REJECT 的 30s/10 次 DROP 升级 —— 真机该域被 REJECT 77~131 次后
#     连接延迟关闭，App 侧报「网络问题/功能卡片缺失」。NO-DROP 变体只回空响应体、
#     不断连（PolicyDecision.swift:26-29 的同语义注释）。
# ============================================================

[Rule]
# ============================================================
# v3 (2026-11-18 修正) 开屏广告图拦截：
#   真机证据(tunnel-diag)：开屏广告图走 http 明文直连
#   `http://static.cebbank.com/fileDir/subject/resource/sjyhzqtp/MOBILEBANKAD/OPENAD/sjyh*.jpg`
#   ENGINE-DECIDE mitm=false action=direct —— rewrite/脚本(MITM-only)碰不到。
#   这里用规则层 URL-REGEX 在 ENGINE-DECIDE 阶段直接 REJECT，与 MITM 无关。
#   只匹配文件名以 sjyh 开头的图片(= 开屏广告图；HomePageImg 下 YLZQ/life/bank
#   等功能入口图标不含 sjyh，不误伤)。
# ============================================================
URL-REGEX,^https?://static\.cebbank\.com/.*sjyh[^/]*\.(png|jpe?g|webp),REJECT
# 埋点 / 数据统计（不影响功能）
DOMAIN,datafinder.cebbank.com,REJECT-DICT-NO-DROP

[Mitm]
hostname = static.cebbank.com

[Script]
# 首页布局配置：开屏广告 ClientNoticeList + 首页弹窗 HomePopList
http-response ^https?:\/\/static\.cebbank\.com\/fileDir\/subject\/resource\/cembpublished\/.*\/clients\/layouts\/KPPage\.json(\?.*)?$ script-path=https://raw.githubusercontent.com/aoconch/cebbank-ad-blocker-loon/main/cebbank_remove_ads.js,requires-body=true,timeout=20,tag=光大去广告(开屏/弹窗),enable=true

# 兜底：其余 layouts 下 Page 级 JSON 配置也过一遍脚本（无广告则原样放行）
http-response ^https?:\/\/static\.cebbank\.com\/fileDir\/subject\/resource\/cembpublished\/.*\/clients\/layouts\/.*Page\.json(\?.*)?$ script-path=https://raw.githubusercontent.com/aoconch/cebbank-ad-blocker-loon/main/cebbank_remove_ads.js,requires-body=true,timeout=20,tag=光大去广告(布局兜底),enable=true
